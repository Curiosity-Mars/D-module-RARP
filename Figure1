audit_rows = []
error_rows = []
 
 
def numeric_array(obj):
    """Return a float array for numeric audit summaries."""
    if isinstance(obj, pd.DataFrame):
        return obj.apply(pd.to_numeric, errors="coerce").to_numpy(dtype=float)
    if isinstance(obj, pd.Series):
        return pd.to_numeric(obj, errors="coerce").to_numpy(dtype=float)
    return np.asarray(obj, dtype=float)
 
 
def record_stage(stage_number, stage_name, obj=None, note="", status="ok"):
    """Record dimensions and missingness immediately after a code stage."""
    row = {
        "stage_number": stage_number,
        "stage_name": stage_name,
        "status": status,
        "object_type": type(obj).__name__ if obj is not None else "",
        "rows": np.nan,
        "columns": np.nan,
        "finite_values": np.nan,
        "nan_values": np.nan,
        "positive_infinity_values": np.nan,
        "negative_infinity_values": np.nan,
        "all_nan_rows": np.nan,
        "column_names": "",
        "note": note,
    }
 
    if obj is not None:
        if isinstance(obj, pd.DataFrame):
            row["rows"], row["columns"] = obj.shape
            row["column_names"] = "|".join(map(str, obj.columns))
        elif isinstance(obj, pd.Series):
            row["rows"] = len(obj)
            row["columns"] = 1
            row["column_names"] = str(obj.name)
        else:
            arr0 = np.asarray(obj)
            row["rows"] = arr0.shape[0] if arr0.ndim >= 1 else 1
            row["columns"] = arr0.shape[1] if arr0.ndim >= 2 else 1
 
        try:
            arr = numeric_array(obj)
            row["finite_values"] = int(np.isfinite(arr).sum())
            row["nan_values"] = int(np.isnan(arr).sum())
            row["positive_infinity_values"] = int(np.isposinf(arr).sum())
            row["negative_infinity_values"] = int(np.isneginf(arr).sum())
            arr2 = arr.reshape(-1, 1) if arr.ndim == 1 else arr
            row["all_nan_rows"] = int(np.isnan(arr2).all(axis=1).sum())
        except Exception as exc:
            row["note"] = (note + " | Numeric audit failed: " + repr(exc)).strip(" |")
 
    audit_rows.append(row)
 
 
def record_error(stage_number, stage_name, exc, code_expression):
    """Preserve an implementation failure instead of silently fixing it."""
    error_rows.append({
        "stage_number": stage_number,
        "stage_name": stage_name,
        "exception_type": type(exc).__name__,
        "exception_message": str(exc),
        "code_expression": code_expression,
        "traceback": traceback.format_exc(),
    })
    record_stage(
        stage_number,
        stage_name,
        obj=None,
        status="error",
        note=f"{type(exc).__name__}: {exc}",
    )
 
 
def save_table(df, filename):
    df.to_csv(OUTPUT_DIR / filename, index=False, encoding="utf-8-sig")
 
 
def summarize_feature_state(feature_df, state_name):
    rows = []
    for column in feature_df.columns:
        values = pd.to_numeric(feature_df[column], errors="coerce")
        finite = values[np.isfinite(values)]
        rows.append({
            "feature_state": state_name,
            "feature": column,
            "n_total": len(values),
            "n_finite": int(np.isfinite(values).sum()),
            "n_nan": int(values.isna().sum()),
            "n_positive_inf": int(np.isposinf(values).sum()),
            "n_negative_inf": int(np.isneginf(values).sum()),
            "mean": float(finite.mean()) if len(finite) else np.nan,
            "sd": float(finite.std(ddof=1)) if len(finite) > 1 else np.nan,
            "median": float(finite.median()) if len(finite) else np.nan,
            "minimum": float(finite.min()) if len(finite) else np.nan,
            "maximum": float(finite.max()) if len(finite) else np.nan,
            "unique_values_including_nan": int(values.nunique(dropna=False)),
        })
    return rows
 
 
def make_first_rise_position(a_frame):
    """Smallest executable interpretation of the first legacy statement."""
    def one_row(row):
        positive = (row > 0).to_numpy(dtype=bool)
        return int(np.argmax(positive)) if np.any(positive) else -1
    return a_frame.apply(one_row, axis=1)
 
 
def make_first_rise_pom(a_frame, months):
    """Later definition in the supplied initial code: actual POM label."""
    def one_row(row):
        positive = (row > 0).to_numpy(dtype=bool)
        return int(months[np.argmax(positive)]) if np.any(positive) else -1
    return a_frame.apply(one_row, axis=1)
 
 
def compute_t_star_exact(row, months):
    """Replay the supplied compute_inflection function exactly."""
    first_derivative = row.values
    second_derivative = np.gradient(first_derivative)
    if np.all(np.isnan(second_derivative)):
        return -1
    peak_idx = np.nanargmax(np.abs(second_derivative))
    return months[peak_idx]
 
 
def compute_psa_peak_month_exact(row, months):
    """Replay the supplied psa_peak_month expression exactly."""
    return months[np.nanargmax(row.values)] if row.notna().any() else -1
 
 
def fit_one_state(feature_df, state_name, kmeans_mode):
    """Fit K=2..6 without scaling, as in the initial code."""
    imputer = SimpleImputer(strategy="median")
    X = imputer.fit_transform(feature_df)
 
    if X.shape[1] != feature_df.shape[1]:
        raise RuntimeError(
            f"SimpleImputer changed feature count for {state_name}: "
            f"{feature_df.shape[1]} -> {X.shape[1]}"
        )
    if not np.isfinite(X).all():
        raise RuntimeError(f"Non-finite KMeans input for {state_name}")
 
    imputation_table = pd.DataFrame({
        "feature_state": state_name,
        "kmeans_mode": kmeans_mode,
        "feature": feature_df.columns,
        "median_used_by_imputer": imputer.statistics_,
        "missing_before_imputation": feature_df.isna().sum().to_numpy(),
    })
 
    metric_rows = []
    labels_by_k = {}
 
    for k in range(2, 7):
        if kmeans_mode == "literal_installed_default":
            # Exact constructor written in the original code.
            model = KMeans(n_clusters=k, random_state=RANDOM_STATE)
        elif kmeans_mode == "historical_default_n_init_10":
            # Compatibility replay of the older scikit-learn default.
            model = KMeans(
                n_clusters=k,
                random_state=RANDOM_STATE,
                n_init=10,
            )
        else:
            raise ValueError(kmeans_mode)
 
        labels = model.fit_predict(X)
        labels_by_k[k] = labels
        counts = np.bincount(labels, minlength=k)
 
        row = {
            "feature_state": state_name,
            "feature_columns": "|".join(feature_df.columns),
            "n_features": feature_df.shape[1],
            "analysis_n": len(X),
            "standardization": "none",
            "imputation": "median",
            "kmeans_mode": kmeans_mode,
            "installed_kmeans_n_init_parameter": str(model.get_params()["n_init"]),
            "k": k,
            "silhouette": float(silhouette_score(X, labels)),
            "cluster_sizes_raw": "|".join(map(str, counts)),
            "cluster_sizes_sorted": "|".join(map(str, np.sort(counts))),
            "reference_cluster_sizes_sorted": "78|372|984" if k == 3 else "",
            "absolute_count_difference_from_reference": (
                int(np.abs(np.sort(counts) - REFERENCE_CLUSTER_COUNTS_SORTED).sum())
                if k == 3 else np.nan
            ),
            "reference_silhouette": (
                REFERENCE_SILHOUETTE_K2 if k == 2
                else REFERENCE_SILHOUETTE_K3 if k == 3
                else np.nan
            ),
            "silhouette_difference_from_reference": (
                float(silhouette_score(X, labels) - REFERENCE_SILHOUETTE_K2)
                if k == 2
                else float(silhouette_score(X, labels) - REFERENCE_SILHOUETTE_K3)
                if k == 3
                else np.nan
            ),
        }
        metric_rows.append(row)
 
    return X, labels_by_k, imputation_table, metric_rows
 
 
def save_assignments_and_trajectory(
    patient_ids,
    feature_df,
    labels,
    state_name,
    kmeans_mode,
    psa_frame,
    psa_columns,
    pom_months,
):
    safe_name = re.sub(r"[^A-Za-z0-9_]+", "_", f"{state_name}_{kmeans_mode}")
 
    assignments = pd.concat(
        [
            pd.Series(patient_ids, name=PATIENT_ID_COL).reset_index(drop=True),
            feature_df.reset_index(drop=True),
        ],
        axis=1,
    )
    assignments["cluster_raw"] = labels
    save_table(assignments, f"assignments_{safe_name}.csv")
 
    trajectory_rows = []
    for cluster_raw in sorted(np.unique(labels)):
        group = psa_frame.loc[labels == cluster_raw]
        for column, pom in zip(psa_columns, pom_months):
            values = pd.to_numeric(group[column], errors="coerce").dropna()
            trajectory_rows.append({
                "feature_state": state_name,
